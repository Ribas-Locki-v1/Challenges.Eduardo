def triangle_type(nums: list[int]) -> str:
    if nums[0] + nums[1] <= nums[2] or nums[1] + nums[2] <= nums[0] or nums[0] + nums[2] <= nums[1]:
        return "none"

    if nums[0] == nums[1] == nums[2]:
        return "equilateral"
    elif nums[0] == nums[1] or nums[1] == nums[2] or nums[0] == nums[2]:
        return "isosceles"
    else:
        return "scalene"

#run tests
print(triangle_type([3, 3, 3]))
print(triangle_type([3, 4, 5]))
print(triangle_type([2, 2, 8]))